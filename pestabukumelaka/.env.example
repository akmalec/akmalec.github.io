# =============================================
# Mailchimp Configuration
# Copy this file to .env and fill in your values
# =============================================
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
MAILCHIMP_LIST_ID=your-mailchimp-list-id-here

# =============================================
# Email Configuration
# =============================================
ADMIN_EMAIL=your-admin-email@example.com
PAYPAL_RECEIVER_EMAIL=your-paypal-email@example.com

# =============================================
# PayPal Configuration
# =============================================
PAYPAL_SANDBOX_MODE=1
PAYPAL_SANDBOX_URL=https://www.sandbox.paypal.com/cgi-bin/webscr
PAYPAL_LIVE_URL=https://www.paypal.com/cgi-bin/webscr

# =============================================
# Site Configuration
# =============================================
SITE_URL=https://yourdomain.com/pestabukumelaka/
ENVIRONMENT=production
